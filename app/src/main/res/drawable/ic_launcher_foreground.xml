<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标前景 v2（2026-07-27 重设计）：
     "印章文" —— 谷歌味道 + 精致 + 克制
     设计原理：
     1. 主体 = 圆角矩形印章（模拟传统朱文印），类比 Google Workspace 的"卡片 + 文字"构图
     2. "文"字居中作为主图形，笔画用 path 描绘（非镂空），4dp 粗细保证小尺寸清晰
     3. "文"字横画略下移（视觉居中补偿，因"文"字重心偏上）
     4. 整体只 2 元素：印章 + 文字；2 色：米色 + 墨黑（背景）
     5. 圆角 8dp（Material 3 medium shape），safe zone 内 6dp 边距
     颜色：米色 #F5F1E8（与 App 窗口背景一致，墨纸气质）
     参见 docs/design/icon-redesign.md -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 印章方框（圆角矩形，模拟印章边框） -->
    <path
        android:fillColor="#F5F1E8"
        android:pathData="
            M30,28
            l48,0
            q8,0 8,8
            l0,36
            q0,8 -8,8
            l-48,0
            q-8,0 -8,-8
            l0,-36
            q0,-8 8,-8
            z" />
    <!-- "文"字横画（最粗，4dp 高） -->
    <path
        android:fillColor="#2C2C2C"
        android:pathData="
            M40,46
            l28,0
            l0,5
            l-28,0
            z" />
    <!-- "文"字撇画（从横画中点向左下） -->
    <path
        android:fillColor="#2C2C2C"
        android:pathData="
            M52,49
            l4,0
            l-10,18
            q-1,2 -3,2
            l-3,0
            q-2,0 -1,-2
            z" />
    <!-- "文"字捺画（从横画中点向右下） -->
    <path
        android:fillColor="#2C2C2C"
        android:pathData="
            M56,49
            l-4,0
            l10,18
            q1,2 3,2
            l3,0
            q2,0 1,-2
            z" />
</vector>
