<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标前景 v4（2026-07-31 设计重构）：
     方案 B：展开的书 + "文"字负空间
     v3（印章文）→ v4（书+文负空间）核心改动：
     1. 从"印章+文字"改为"书+文字负空间"——书形占 safe zone 70%+
     2. 单 path + evenOdd fillType 实现镂空，不再用 5 个独立 path
     3. "文"字简化为 3 笔（横、撇、捺），去掉"点"画
     4. 笔画平底收笔（无 serif），小尺寸更清晰
     5. "文"字垂直居中于书页（y=50-66，书中心 y=58）
     设计参考：
     - Google Play Books（书形）+ Google Docs（字母负空间）混合
     - Material 3 adaptive icon 规范（safe zone 72x72）
     - 中文阴文传统（墨黑底 + 米色书页 + 镂空文字）
     颜色：米色 #F5F1E8（前景）+ 墨黑 #2C2C2C（背景层）
     参见 docs/design/icon-redesign.md -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 书页 + "文"字负空间（单一 path，evenOdd 镂空）
         外环：展开的书页俯视图（顺时针）
         书页左上 → 左书脊 → 右书脊 → 书页右上 → 书页右下 → 右书脊底 → 左书脊底 → 书页左下
         内环："文"字轮廓（逆时针，evenOdd 规则自动镂空）
         横画 y=50-54，撇捺 y=54-66，平底收笔 -->
    <path
        android:fillColor="#F5F1E8"
        android:fillType="evenOdd"
        android:pathData="
            M28,36
            L52,44
            L56,44
            L80,36
            L80,72
            L56,80
            L52,80
            L28,72
            Z
            M40,50
            L68,50
            L68,54
            L58,54
            L66,66
            L58,66
            L54,58
            L50,66
            L42,66
            L50,54
            L40,54
            Z" />
</vector>