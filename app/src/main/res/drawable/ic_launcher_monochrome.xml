<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标 monochrome 层 v7（Android 13+ themed icon）。
     系统根据用户壁纸/主题自动着色此矢量图。
     v7 monochrome 与 v7 foreground 主体一致（白书双页），但保留书脊缝隙（系统染色后形成自然书脊）。
     文字线在此层省略——单色 themed icon 主体越简越好，文字线在主题色下会与小书页混淆。
     参见 docs/design/icon-redesign.md -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 左页 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,30 L52,30 L52,78 L30,78 Q22,78 22,70 L22,38 Q22,30 30,30 Z" />

    <!-- 右页 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M56,30 L78,30 Q86,30 86,38 L86,70 Q86,78 78,78 L56,78 Z" />
</vector>
