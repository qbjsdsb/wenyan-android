<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 文研App 基础主题，Compose 接管实际 UI，此处仅保留启动主题 -->
    <style name="Theme.Wenyan" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/wenyan_window_background</item>
    </style>

    <!--
      Splash Screen 主题（NF-S3 修复）。
      Android 12+ 系统原生支持 SplashScreen API，向后兼容至 API 23（由 core-splashscreen 库提供）。
      - windowSplashScreenBackground: 冷启动背景色，与应用窗口背景一致，避免白屏闪烁
      - windowSplashScreenAnimatedIcon: 居中显示的应用图标（adaptive foreground）
      - postSplashScreenTheme: splash 消失后切换回的主主题
    -->
    <style name="Theme.Wenyan.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wenyan_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Wenyan</item>
    </style>
</resources>
